name = "LL728/moonvorbis"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/LL728/moonvorbis"

license = "Apache-2.0"

keywords = [ "vorbis", "ogg", "audio", "decoder", "codec", "wasm" ]

description = "纯 MoonBit 实现的 OGG/Vorbis 音频解码器，不依赖任何 C 库或系统编解码器"

preferred_target = "wasm-gc"

import {
  "moonbitlang/x@0.5.5",
}
